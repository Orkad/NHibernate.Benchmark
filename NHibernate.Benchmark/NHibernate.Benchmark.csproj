<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
    <PackageReference Include="Bogus" Version="35.6.3" />
    <PackageReference Include="FluentNHibernate" Version="3.4.1" />
    <PackageReference Include="NHibernate" Version="5.5.2" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\NHibernate.Benchmark.AuthorWork\NHibernate.Benchmark.AuthorWork.csproj" />
  </ItemGroup>

  <!-- EfCoreComparison/ benchmarks need the net10.0-only AuthorWork.EfCore project, which
       doesn't support net48, so both the reference and the source files are restricted
       to the net10.0 leg of this project's own multi-targeting. -->
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <ProjectReference Include="..\NHibernate.Benchmark.AuthorWork.EfCore\NHibernate.Benchmark.AuthorWork.EfCore.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'!='net10.0'">
    <Compile Remove="EfCoreComparison\**\*.cs" />
  </ItemGroup>
</Project>
